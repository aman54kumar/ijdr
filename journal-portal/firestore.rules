rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validContactCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'read'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.email is string
        && data.email.size() <= 320
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 10000
        && data.read == false
        && data.createdAt is timestamp;
    }

    match /journals/{journalId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Public view-count bumps: only viewCount + updatedAt, and viewCount must increase by exactly 1
      // (handles missing viewCount via get(..., 0); required for new issues created without the field).
      allow update: if isAdmin()
        || (
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['viewCount', 'updatedAt'])
             && request.resource.data.viewCount is int
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.viewCount
                  == resource.data.get('viewCount', 0) + 1
           );
    }

    match /articles/{articleId} {
      // Public queries must filter on status == 'published'.
      allow read: if isAdmin() || resource.data.status == 'published';
      allow update: if isAdmin()
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      // Public view-count bumps on published articles: viewCount only, +1 exactly.
      allow update: if resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
      allow create: if isAdmin()
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow delete: if isAdmin();
    }

    // Cached AI content (summary, translation, related) of published articles. Written by
    // functions (Admin SDK); admins may also edit (e.g. hide a summary). Embedding vectors stay admin-only.
    match /articles/{articleId}/ai/{docId} {
      allow read: if isAdmin()
        || (docId != 'embedding'
            && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published');
      allow write: if isAdmin();
    }

    match /aiStats/{day} {
      allow read: if isAdmin();
    }

    // Written by the ingestIssue function (Admin SDK); admins may read and write.
    match /ingestJobs/{issueId} {
      allow read, write: if isAdmin();
    }

    match /ingestStats/{day} {
      allow read, write: if isAdmin();
    }

    match /boardMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /contactSubmissions/{id} {
      allow create: if validContactCreate();
      allow read, update, delete: if isAdmin();
    }

    // Manuscript submissions are created by the submitManuscript function (Admin SDK) only;
    // clients can never write them. Admins read them and move them through the workflow.
    match /submissions/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Append-only record of admin actions: admins create entries (as themselves) and read them.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }

    // Daily rollups are written by a scheduled function.
    match /statsDaily/{day} {
      allow read: if isAdmin();
    }

    // Private admin configuration (e.g. notification recipients). siteSettings is public, so
    // anything containing email addresses belongs here instead.
    match /adminSettings/{docId} {
      allow read, write: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
